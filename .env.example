# Docker Compose environment
#
# Copy this file to `.env` (in this same directory) and fill in real values.
# `docker compose up` reads it automatically and substitutes the ${VARS}
# referenced in docker.compose.yaml. This file is committed; `.env` is NOT.
#
# NOTE: this is only for `docker compose`. Running the backend directly with
# `npm run dev` uses backend/.env instead (see backend/.env.example).

# --- Secrets (required) ---
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_characters
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_app_password

# --- App config (required) ---
FRONTEND_URL=https://your-frontend-domain.com

# --- Optional overrides (sensible defaults are baked into docker.compose.yaml) ---
# MONGODB_URI=mongodb://mongo:27017/sportshub   # defaults to the bundled mongo service
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_URL=
# JWT_EXPIRE_IN=1h
# SALT_ROUND=10
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_FROM=your_email@example.com
